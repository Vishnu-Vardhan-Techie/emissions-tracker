# Copy to .env and edit. Never commit .env.
# Generate a secret:  openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ORG_NAME=Acme Corp
# Set to true on first start to load two years of sample data and a demo target
SEED_DEMO=false
WEB_PORT=8080
# Optional FX rates to USD for invoices, e.g. {"EUR":1.08,"GBP":1.27,"INR":0.012}
CURRENCY_RATES=
